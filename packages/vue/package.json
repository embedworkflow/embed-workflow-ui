{
  "name": "@embedworkflow/vue",
  "version": "0.1.0",
  "description": "Vue 3 components for embedding EmbedWorkflow UI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@embedworkflow/embed-core": "^0.2.0"
  },
  "peerDependencies": {
    "vue": "^3.3"
  },
  "devDependencies": {
    "vue": "^3.5.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
