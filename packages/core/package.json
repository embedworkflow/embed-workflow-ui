{
  "name": "@embedworkflow/embed-core",
  "version": "0.1.0",
  "description": "Framework-agnostic core for embedding EmbedWorkflow UI (typed client over window.EWF).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  }
}
